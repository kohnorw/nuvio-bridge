# Copy to .env before running docker compose up.

# The URL your devices use to reach this container, e.g.
# https://nuvio.yourdomain.tld or http://192.168.1.50:8080
# VLC for iOS returns here when playback ends, so it must be reachable from
# the phone — not localhost.
PUBLIC_URL=http://192.168.1.50:8080

# Encrypts stored Nuvio refresh tokens. Generate with: openssl rand -hex 32
# Leave blank and one is generated into the data volume on first boot; set it
# explicitly if you want sessions to survive the volume being recreated.
SESSION_SECRET=

# Binge playlists: how many episodes to queue, and how long a playlist URL
# stays valid. The default expiry roughly matches how long debrid links live.
BINGE_EPISODE_LIMIT=60
PLAYLIST_TTL_HOURS=24

# Dead links fall through to the next candidate. STREAM_PROBE is head (default),
# off, or full. Avoid `full` with debrid providers that issue single-use links:
# its range request can consume the link before VLC ever plays it.
STREAM_PROBE=head
STREAM_PROBE_LIMIT=3
STREAM_PROBE_TIMEOUT_MS=6000

# Let people create a Nuvio account from the sign-in screen.
ALLOW_SIGNUP=false

# The in-page player can't load an http stream from an https page, and a few
# hosts refuse hotlinks. Setting this true lets those play by passing them
# through the server — at the cost of every byte of video crossing it.
MEDIA_PROXY=false

# Lumen, the built-in converter. With it on, the player in the page handles
# every file on every device — the server remuxes or converts what the browser
# can't take — and VLC is the fallback. TRANSCODE=false turns it off.
TRANSCODE=true
TRANSCODE_MAX=3
TRANSCODE_AHEAD_SECS=90
# auto, none, nvenc, qsv, vaapi, videotoolbox, amf, v4l2m2m
TRANSCODE_HWACCEL=auto
TRANSCODE_MAX_HEIGHT=1080

# Nuvio's publishable key is built in and you do not need to set these.
# Only override them to point at a different backend.
# NUVIO_BACKEND_URL=https://api.nuvio.tv
# NUVIO_ANON_KEY=

# Or point at your own Nuvio server and let it self-configure from
# /.well-known/nuvio at startup.
# NUVIO_SERVER=nuvio.yourdomain.tld

# Hide streams above this resolution everywhere (1080 = no 4K). 0 shows all.
MAX_STREAM_RESOLUTION=1080
